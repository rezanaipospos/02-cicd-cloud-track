---
# =============================================================================
# Jenkins Credentials — ISI NILAI MILIKMU lalu rename jadi jenkins_credentials.yml
#
# File ini berisi env vars yang dibutuhkan JCasC.
# JANGAN commit file yang sudah diisi (tanpa .example) ke git!
# Atau gunakan ansible-vault: ansible-vault encrypt jenkins_credentials.yml
#
# Cara pakai:
#   1. cp jenkins_credentials.yml.example jenkins_credentials.yml
#   2. Isi semua nilai di bawah
#   3. Jalankan playbook: ansible-playbook playbooks/jenkins.yml
#   4. (Opsional) Encrypt: ansible-vault encrypt jenkins_credentials.yml
# =============================================================================

# --- Jenkins Admin ---
jenkins_admin_user: "admin"
jenkins_admin_password: "GANTI_PASSWORD_INI"

# --- GitHub ---
jenkins_github_username: "your-github-username"
jenkins_github_token: "ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
jenkins_github_webhook_secret: "GANTI_DENGAN_RANDOM_STRING"
jenkins_github_org: "your-github-org-or-user"

# --- Slack (opsional — kosongi jika belum pakai) ---
jenkins_slack_token: ""
jenkins_slack_workspace: ""

# --- Shared Library ---
jenkins_shared_library_repo: "https://github.com/your-org/shared-library.git"

# --- Jenkins URL (domain yang resolve ke IP publik VM) ---
jenkins_url: "https://jenkins.yourdomain.com/"
